{
  "mcpServers": {
    "crosscheck": {
      "command": "npx",
      "args": ["-y", "crosscheckapi@0.4.0"],
      "env": {
        "CROSSCHECK_WALLET_KEY": "${CROSSCHECK_WALLET_KEY:-}",
        "CROSSCHECK_MAX_USD": "${CROSSCHECK_MAX_USD:-0.10}",
        "CROSSCHECK_NETWORKS": "${CROSSCHECK_NETWORKS:-eip155:8453,eip155:84532}"
      }
    }
  }
}
